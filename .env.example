# Optional future provider integration. The current Model Broker has no provider.
# Never mount this file or provider credentials into a TaskCapsule.
# MODEL_PROVIDER_API_KEY=

# Integrated application settings; generate distinct secrets, never commit values.
AG_OWNER_TOKEN=
AG_RUNTIME_TOKEN=
AG_INTEGRITY_KEY=
AG_SENSOR_REGISTRY=
AG_LOCAL_MODEL_ENABLED=false
# Optional operator-reviewed immutable LOCAL image ID for fixed probes only.
AG_LAB_IMAGE_ID=
# Used by the trusted Linux capture forwarder only; never inside a capsule.
AG_SENSOR_TOKEN=
